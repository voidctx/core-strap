{
    "layer": "top", // Waybar at top layer
    "position": "top", // Waybar position (top|bottom|left|right)
    "height": 30,
    "margin": "0 0 0 0",
    "spacing":0,

    // Choose the order of the modules
    // Add according to your wishes: "custom/weather"

    "modules-left": ["hyprland/workspaces", "hyprland/window"],
    "modules-center": ["clock"],
    "modules-right": ["battery", "network", "tray"],

 // Modules configuration

  "hyprland/workspaces": {
    "format": "{icon}",
    "all-outputs": true,
    "sort-by-number": true,
    "format-icons":{
    	"active":"#",
    	},
    "exec": "hyprctl activeworkspace | awk '{print $3; exit}'",
    },
    
    "hyprland/window": {
        "format": "{}",
	"icon":true,
	"icon-size" : 20
    },
    "tray": {
        "icon-size": 20,
        "spacing": 5
    },
    "clock": {
        "tooltip-format": "<big>{:%A, %d }</big>\n<tt><small>{calendar}</small></tt>",
        "format": "{:%d/%m  %I:%M %p}", //12 hour format
        "format-alt": "{:%d/%m  %H:%M}", //24 hour format
        "interval": 1,
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{capacity}%",
        "interval": 2,
        "on-click": "foot htop"
    },
      "network": {
        "format": "Disabled",
        "format-wifi": "Wi-Fi {signalStrength}%",
        "format-ethernet": "ETH",
        "format-linked": "{ifname} (No IP)",
        "format-disconnected": "Disconnected",
        "family": "ipv4",
        "tooltip-format-wifi": " {ifname} @ {essid}\nIP: {ipaddr}\nFreq: {frequency}MHz\nUp: {bandwidthUpBits} Down: {bandwidthDownBits}",
        "tooltip-format-ethernet": " {ifname}\nIP: {ipaddr}\n up: {bandwidthUpBits} down: {bandwidthDownBits}",
        "on-click": "nm-applet"
    },
}
